{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "identity-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "https://suyash503.github.io,http://localhost:5173",
    // Photo databases in order; new photos go to the last one. When it fills up,
    // create identity-photos-N, add its binding below and append it here.
    "PHOTO_SHARDS": "PHOTOS_1",
    "PHOTO_SHARD_LIMIT_MB": "450",
    // Public half of the notification signing key. The private half is the VAPID_PRIVATE_KEY secret.
    "VAPID_PUBLIC_KEY": "BObHkpu4AzcCF6O_50qx5zBvSrZAE2309fWGj-ndF9RAKwAU42oHXvtTs2tE8Rj_nYLsFy_0swnL9cuZG9PPycM",
    "VAPID_SUBJECT": "https://suyash503.github.io/identity/"
  },
  // Checks every 15 minutes whether a notification is due.
  "triggers": { "crons": ["*/15 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "identity",
      "database_id": "f7e369fa-dd2c-4b3a-a298-a422f3d890b7",
      "migrations_dir": "migrations"
    },
    {
      "binding": "PHOTOS_1",
      "database_name": "identity-photos-1",
      "database_id": "991f1d30-0ea4-4f89-9056-d65aef031ebb",
      "migrations_dir": "migrations-photos"
    }
  ]
}
